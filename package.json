{
  "name": "dsh-applab-bridge",
  "version": "0.1.2",
  "description": "Bridge Arduino App Lab / UNO Q into DeepSeek Harness (DSH): list, create, start and stop apps, tail logs, and pull/push app sources over adb.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "check": "node --check index.js && node --check lib/adb.js && node --check lib/commands.js && node --check lib/config.js && node --check lib/board.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "arduino",
    "arduino-app-lab",
    "uno-q",
    "ventuno-q",
    "adb",
    "arduino-app-cli",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatsuneIridium/dsh-applab-bridge.git"
  },
  "homepage": "https://github.com/hatsuneIridium/dsh-applab-bridge#readme",
  "license": "GPL-3.0"
}
